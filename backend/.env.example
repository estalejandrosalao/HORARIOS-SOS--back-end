# Cadena de conexión de PostgreSQL (en Render usa la "Internal Database URL")
DATABASE_URL=postgresql://usuario:clave@localhost:5432/horarios_sos
PORT=3000
# Cadena larga y aleatoria. Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
